{
  "manifest_version": 3,
  "name": "Keyline: Gmail Keyboard Shortcuts, Command Palette & Split Inbox",
  "version": "0.7.17",
  "key": "",
  "description": "Keyboard-first Gmail: Cmd+K palette, shortcuts, split inbox, snooze presets and undo send. Free, open source, never reads your mail.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://calendar.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "css": [
        "src/shared/themes.css",
        "src/content/palette.css"
      ],
      "js": [
        "src/shared/hashutil.js",
        "src/shared/keymap.js",
        "src/shared/when.js",
        "src/shared/links.js",
        "src/content/storage.js",
        "src/shared/theme.js",
        "src/content/account-sync.js",
        "src/content/toast.js",
        "src/content/cheatsheet.js",
        "src/content/gmail.js",
        "src/content/accounts.js",
        "src/content/calendar.js",
        "src/content/listnav.js",
        "src/content/threadnav.js",
        "src/content/tabs.js",
        "src/content/focus.js",
        "src/content/commands.js",
        "src/content/palette.js",
        "src/content/later.js",
        "src/content/contacts.js",
        "src/content/undosend.js",
        "src/content/share.js",
        "src/content/hotkeys.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "css": [
        "src/shared/themes.css",
        "src/content/palette.css"
      ],
      "js": [
        "src/shared/hashutil.js",
        "src/shared/keymap.js",
        "src/content/storage.js",
        "src/shared/theme.js",
        "src/content/account-sync.js",
        "src/content/toast.js",
        "src/content/cheatsheet.js",
        "src/content/gcal.js",
        "src/content/gcal-ui.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*",
        "https://calendar.google.com/*"
      ],
      "js": [
        "src/content/account-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
